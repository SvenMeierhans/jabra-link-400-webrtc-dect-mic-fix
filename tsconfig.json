{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "node",
      "w3c-web-hid",
      "dom-mediacapture-transform",
      "dom-webcodecs"
    ],
    "paths": {
      "jabra-link-400-webrtc-dect-mic-fix": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "lab",
    "userscript",
    "examples/vanilla",
    "test",
    "vite.config.ts",
    "vite.userscript.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
